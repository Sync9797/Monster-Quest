<?xml version="1.0" encoding="utf-8"?>
<!--
  Smoked glass for the widgets: a mid-tone tint taken from the wallpaper's
  colors (Android 12+), see-through, with no white sheen, and a faint rim.
  (Only the launcher's own widgets can blur the wallpaper; this matches their tone.)
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="@color/widget_glass_tint" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#1FFFFFFF" />
        </shape>
    </item>
</layer-list>
