<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted glass for the 2x2 widget: a see-through tint, a glossy sheen from the top, and a thin bright rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="@color/widget_glass_tint" />
        </shape>
    </item>
    <!-- Gloss: light catching the top of the glass, fading out by the middle. -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="270"
                android:centerY="0.45"
                android:startColor="#4DFFFFFF"
                android:centerColor="#0FFFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
    <!-- A soft glow rising from the bottom edge. -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="90"
                android:centerY="0.25"
                android:startColor="#1AFFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
    <!-- The rim. -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#40FFFFFF" />
        </shape>
    </item>
</layer-list>
